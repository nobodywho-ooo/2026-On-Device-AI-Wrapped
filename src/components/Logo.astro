---
/** Brand logos for news items that set `logo:` in their frontmatter. */
interface Props {
  name: 'apple' | 'google' | 'android' | 'bonsai' | 'gemma' | 'liquid' | 'qwen' | 'pytorch';
  class?: string;
}

const { name, class: className = 'size-10' } = Astro.props;
// Gradient ids must be unique when the same logo appears several times on the page.
const uid = Math.random().toString(36).slice(2, 8);
