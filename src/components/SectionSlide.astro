---
import type { CollectionEntry } from 'astro:content';
import Slide from './Slide.astro';
import ItemIcon from './ItemIcon.astro';
import { themes } from '../themes';
import { formatDate, formatDateRange, statFontSize } from '../lib/format';
import type { sections } from '../sections';

/**
 * Chapter opener: big title plus a "tracklist" of the slides that follow.
 * For `single` chapters, the items are shown right here as cards instead.
 */
interface Props {
  section: (typeof sections)[number];
  number: number;
  items: CollectionEntry<'news'>[];
}

const { section, number, items } = Astro.props;
const theme = themes[section.theme];
const chapter = String(number).padStart(2, '0');
const single = 'single' in section && section.single;
---

<Slide id={section.id} class:list={[theme.bg, theme.text]} blob={theme.blob} label={`Chapter ${number}: ${section.title}`}>
  {
    single ? (
      <>
        <div class="grid items-end gap-4 lg:grid-cols-[auto_1fr] lg:gap-12">
          <div>
            <p class="reveal text-sm font-semibold tracking-[0.3em] uppercase opacity-80" style="--i:0">
              Chapter {chapter}
            </p>
            <h2
              class="reveal reveal-pop font-display mt-2 text-[clamp(2.5rem,8vw,6rem)] sm:mt-3 leading-[0.85] font-extrabold tracking-tighter"
              style="--i:1"
            >
              {section.title}
            </h2>
          </div>
          <p class="reveal max-w-md text-base leading-snug opacity-90 sm:text-xl" style="--i:2">
            {section.subtitle}
          </p>
        </div>

        <div class="mt-5 grid gap-3 sm:mt-8 sm:gap-6 md:grid-cols-2">
          {items.map((item, i) => {
            const t = themes[item.data.theme];
            const link = item.data.links[0];
            return (
              <article
                id={item.id}
                class:list={['reveal flex flex-col rounded-3xl p-5 sm:rounded-[2rem] sm:p-8', t.bg, t.text]}
                style={`--i:${i + 3}`}
              >
                <p class="flex items-center gap-3 text-xs font-semibold tracking-wide uppercase sm:text-sm">
                  <ItemIcon logo={item.data.logo} emoji={item.data.emoji} logoClass="size-8 sm:size-10" emojiClass="text-3xl leading-none sm:text-4xl" />
                  <span class="opacity-80">
                    {formatDate(item.data.date)} · {item.data.org}
                  </span>
                </p>
                {item.data.stat && (<>
                <div class="@container">
                  <p
                    class="font-display mt-3 leading-none font-extrabold whitespace-nowrap sm:mt-4"
                    style={`font-size: ${statFontSize(item.data.stat.value, 'clamp(2.75rem,6vw,4.5rem)')}`}
                  >
                    {item.data.stat.value}
                  </p>
                </div>
                <p class="mt-1 text-sm font-medium opacity-80">{item.data.stat.label}</p>
                </>)}
                <h3 class="font-display mt-3 text-xl leading-tight font-extrabold sm:mt-5 sm:text-3xl">{item.data.title}</h3>
                <p class="mt-3 hidden leading-relaxed opacity-90 sm:block">{item.data.summary}</p>
                {item.data.highlights.length > 0 && (
                  <ul class="mt-4 hidden space-y-1.5 text-sm sm:block">
                    {item.data.highlights.map((h) => (
                      <li class="flex gap-3 leading-snug">
                        <span class:list={['mt-1.5 size-2 shrink-0 rounded-full', t.accent]} />
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {link && (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener"
                    class:list={[
                      'mt-4 self-start rounded-full px-3 py-1.5 text-xs font-semibold sm:mt-6 sm:px-4 sm:py-2 sm:text-sm transition hover:scale-105',
                      t.accent,
                    ]}
                  >
                    {link.label} ↗
                  </a>
                )}
              </article>
            );
          })}
        </div>
      </>
    ) : (
      <div class="grid items-end gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
        <div>
          <p class="reveal text-sm font-semibold tracking-[0.3em] uppercase opacity-80" style="--i:0">
            Chapter {chapter}
          </p>
          <h2
            class="reveal reveal-pop font-display mt-3 text-[clamp(3.5rem,11vw,8.5rem)] leading-[0.85] font-extrabold tracking-tighter"
            style="--i:1"
          >
            {section.title}
          </h2>
          <p class="reveal mt-6 max-w-lg text-xl leading-snug opacity-90 sm:text-2xl" style="--i:2">
            {section.subtitle}
          </p>
        </div>

        <ol class="space-y-2">
          {items.map((item, i) => (
            <li class="reveal" style={`--i:${i + 3}`}>
              <a
                href={`#${item.id}`}
                class="group flex items-center gap-4 rounded-2xl px-3 py-2.5 transition hover:bg-current/10"
              >
                <span class="font-display w-6 text-right text-lg font-bold opacity-60">{i + 1}</span>
                <ItemIcon
                  logo={item.data.logo}
                  emoji={item.data.emoji}
                  logoClass="size-[1.875rem] shrink-0"
                  emojiClass="text-3xl leading-none"
                />
                <span class="min-w-0">
                  <span class="block text-lg leading-tight font-bold group-hover:underline">{item.data.title}</span>
                  <span class="block text-sm opacity-75">
                    {item.data.timeline ? formatDateRange(item.data.timeline.map((e) => e.date)) : formatDate(item.data.date)} ·{' '}
                    {item.data.org}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    )
  }
</Slide>
