---
/** A full-screen "story" card. Blobs give each slide its moving colour wash. */
interface Props {
  id: string;
  class?: string;
  blob?: string;
  label: string;
}

const { id, class: className = '', blob = 'bg-violet-600', label } = Astro.props;
---

<section
  id={id}
  data-slide
  aria-label={label}
  class:list={[
    'relative isolate flex min-h-dvh w-full snap-start items-center overflow-hidden',
    'px-4 pt-16 pb-12 sm:px-10 lg:px-20',
    className,
  ]}
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class:list={['animate-float absolute -top-1/4 -right-1/4 size-[70vmax] rounded-full opacity-60 blur-3xl', blob]}></div>
    <div class:list={['animate-float-slow absolute -bottom-1/3 -left-1/4 size-[55vmax] rounded-full opacity-40 blur-3xl', blob]}></div>
  </div>
  <div class="mx-auto w-full max-w-6xl">
    <slot />
  </div>
</section>
