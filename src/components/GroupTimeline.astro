---
import { formatDate, formatDateRange } from '../lib/format';

/**
 * A timeline where each stop is a group of small dated items (frontmatter `groups:`).
 * On wide screens every card sits above the line, in two staggered tiers, joined to its
 * dot by a stem, with the group's months under the dot. Staggering lets each card be twice
 * as wide as its share of the line. On phones it's a vertical list.
 */
interface Props {
  groups: { name: string; items: { label: string; date: Date }[]; detail?: string }[];
  /** Theme classes for the dots. */
  accent: string;
  /** Theme classes for the cards. */
  card: string;
}

const { groups, accent, card } = Astro.props;
const byDate = <T extends { date: Date }>(xs: T[]) => [...xs].sort((a, b) => a.date.getTime() - b.date.getTime());
const sorted = groups
  .map((g) => ({ ...g, items: byDate(g.items), months: formatDateRange(g.items.map((it) => it.date)) }))
  .sort((a, b) => a.items[0].date.getTime() - b.items[0].date.getTime());
const allDates = sorted.flatMap((g) => g.items.map((i) => i.date));
// One more column than groups: each card spans two columns, centred on its dot.
const columns = `repeat(${sorted.length + 1}, minmax(0, 1fr))`;
---

<ol
  class="relative mt-6 grid gap-3 sm:mt-10 sm:gap-4"
  style={`--columns: ${columns}`}
  aria-label={`Timeline, ${formatDateRange(allDates)}`}
>
  <span aria-hidden="true" class="absolute top-2 bottom-2 left-[0.6875rem] w-0.5 bg-current opacity-40 lg:hidden"></span>
  <span aria-hidden="true" class="line hidden h-0.5 self-center bg-current opacity-40 lg:block"></span>
  {
    sorted.map((g, i) => (
      <li
        class="relative pl-10 lg:contents"
        data-tier={i % 2 === 0 ? 'high' : 'low'}
        style={`--i:${i + 4}; --col: ${i + 1} / span 2`}
      >
        <span aria-hidden="true" class="stem reveal hidden w-0.5 bg-current opacity-40" style={`--i:${i + 4}`} />
        <span
          aria-hidden="true"
          class:list={['dot reveal absolute top-1 left-0 size-6 rounded-full ring-4 ring-current/30', accent]}
          style={`--i:${i + 4}`}
        />
        <span class="months reveal hidden text-xs font-semibold tracking-wide uppercase opacity-80 sm:text-sm" style={`--i:${i + 4}`}>
          {g.months}
        </span>
        <div class:list={['card reveal rounded-2xl p-4 sm:rounded-3xl sm:p-5', card]} style={`--i:${i + 4}`}>
          <span class="text-xs font-semibold tracking-wide uppercase opacity-75 sm:text-sm lg:hidden">{g.months}</span>
          <h3 class="font-display mt-1 text-2xl leading-none font-extrabold tracking-tight lg:mt-0 lg:text-3xl">{g.name}</h3>
          <ul class="mt-3 space-y-1 text-sm sm:text-base">
            {g.items.map((it) => (
              <li class="flex items-baseline justify-between gap-3">
                <span>{it.label}</span>
                <span class="shrink-0 text-xs tabular-nums opacity-70 sm:text-sm">{formatDate(it.date)}</span>
              </li>
            ))}
          </ul>
          {g.detail && <p class="mt-3 text-sm leading-snug opacity-85">{g.detail}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  /*
   * Rows: 1 high cards, 2 gap, 3 low cards, 4 stems of the low cards, 5 the line, 6 months.
   * A high card's stem runs down through the gap between the two low cards next to it.
   */
  @media (min-width: 64rem) {
    ol {
      grid-template-columns: var(--columns);
      grid-template-rows: auto 1rem auto 1.75rem 1.5rem auto;
      gap: 0 1.5rem;
    }
    .line {
      grid-column: 1 / -1;
      grid-row: 5;
    }
    .card,
    .stem,
    .dot,
    .months {
      grid-column: var(--col);
    }
    [data-tier='high'] .card {
      grid-row: 1;
    }
    [data-tier='low'] .card {
      grid-row: 3;
    }
    .stem {
      display: block;
      justify-self: center;
    }
    [data-tier='high'] .stem {
      grid-row: 2 / 5;
    }
    [data-tier='low'] .stem {
      grid-row: 4 / 5;
    }
    .dot {
      position: static;
      grid-row: 5;
      justify-self: center;
      align-self: center;
    }
    .months {
      display: block;
      grid-row: 6;
      justify-self: center;
      margin-top: 0.75rem;
    }
  }
</style>
