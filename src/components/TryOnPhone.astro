---
/**
 * The "Try it on your phone" popup. Rendered once on the page; any element
 * with `data-try-on-phone` opens it. Text and store links live in `src/site.config.ts`.
 */
import Logo from './Logo.astro';
import { site } from '../site.config';

const { tryOnPhone: t } = site;
const stores = [
  { logo: 'apple', ...t.ios },
  { logo: 'android', ...t.android },
] as const;
---

<dialog
  id="try-on-phone"
  aria-labelledby="try-on-phone-title"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl bg-white p-6 text-zinc-950 shadow-2xl backdrop:bg-zinc-950/70 backdrop:backdrop-blur-sm sm:p-8"
>
  <div class="flex flex-row-reverse">
    <button
      type="button"
      data-close
      aria-label="Close"
      class="-m-2 grid size-10 place-items-center rounded-full text-2xl leading-none transition hover:bg-zinc-100"
    >
      ×
    </button>
  </div>
  <h2 id="try-on-phone-title" class="font-display mt-4 text-3xl leading-none font-extrabold tracking-tight">
    {t.title}
  </h2>
  <p class="mt-3 leading-relaxed text-zinc-600">{t.body}</p>
  <div class="mt-6 grid gap-3">
    {
      stores.map((store) => (
        <a
          href={store.url}
          target="_blank"
          rel="noopener"
          class="flex items-center gap-4 rounded-2xl bg-zinc-950 px-5 py-4 font-semibold text-white transition hover:scale-[1.02]"
        >
          <Logo name={store.logo} class="size-7 shrink-0" />
          <span>{store.label}</span>
          <span class="ml-auto opacity-60" aria-hidden="true">↗</span>
        </a>
      ))
    }
  </div>
</dialog>

<script>
  const dialog = document.getElementById('try-on-phone') as HTMLDialogElement;
  document.querySelectorAll('[data-try-on-phone]').forEach((button) =>
    button.addEventListener('click', () => dialog.showModal()),
  );
  dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
  // Clicking the dimmed backdrop (the dialog element itself, outside its content) closes it.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
