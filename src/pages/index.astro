---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Slide from '../components/Slide.astro';
import NewsSlide from '../components/NewsSlide.astro';
import TimelineSlide from '../components/TimelineSlide.astro';
import SectionSlide from '../components/SectionSlide.astro';
import TryOnPhone from '../components/TryOnPhone.astro';
import { site } from '../site.config';
import { sections } from '../sections';
import { formatDate } from '../lib/format';

const allNews = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime(),
);

// Group the news into chapters (in the order of src/sections.ts), dropping empty ones.
const chapters = sections
  .map((section) => ({ section, items: allNews.filter((n) => n.data.section === section.id) }))
  .filter((c) => c.items.length > 0);
// News in the order it is shown, so slide numbers follow the page.
const news = chapters.flatMap((c) => c.items);

// Numbers for the "year in numbers" slide, computed from the news files.
const modelCount = news.filter((n) => n.data.category === 'model').length;
const orgCount = new Set(news.flatMap((n) => n.data.org.split(/\s*×\s*/))).size;

const stats = [
  { value: news.length, label: 'big moments' },
  { value: modelCount, label: 'major model families' },
  { value: orgCount, label: 'companies & projects' },
];

const more = (await getCollection('more', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime(),
);
const { credits } = site;

// One progress-bar segment per slide; chapter openers get a little extra space before them.
const slideIds = [
  { id: 'intro' },
  { id: 'numbers' },
  ...chapters.flatMap((c) => [
    { id: c.section.id, chapter: true },
    ...('single' in c.section ? [] : c.items.map((n) => ({ id: n.id }))),
  ]),
  ...(more.length > 0 ? [{ id: 'more', chapter: true }] : []),
  { id: 'credits' },
];
// Table of contents on the "year in numbers" slide.
const chapterLinks = [
  ...chapters.map(({ section }, c) => ({ id: section.id, number: String(c + 1).padStart(2, '0'), title: section.title })),
  ...(more.length > 0 ? [{ id: 'more', number: '+', title: site.more.title }] : []),
];
const marquee = news.map((n) => `${n.data.emoji} ${n.data.title}`).join('  ·  ');
---

<Layout>
  <!-- Story-style progress bar -->
  <nav aria-label="Slides" class="fixed inset-x-0 top-0 z-50 flex gap-1 p-3 mix-blend-difference sm:gap-1.5 sm:px-6">
    {
      slideIds.map(({ id, chapter }, i) => (
        <a
          href={`#${id}`}
          data-progress={id}
          aria-label={`Go to slide ${i + 1}`}
          class:list={['group h-6 flex-1 py-2.5', chapter && 'ml-1.5 sm:ml-3']}
        >
          <span class="block h-1 overflow-hidden rounded-full bg-white/35">
            <span class="block h-full w-0 rounded-full bg-white transition-[width] duration-500 group-data-[state=done]:w-full group-data-[state=current]:w-full" />
          </span>
        </a>
      ))
    }
  </nav>

  <main id="deck" class="relative h-dvh snap-y snap-proximity overflow-y-auto scroll-smooth lg:snap-mandatory">
    <!-- 1. Intro -->
    <Slide id="intro" class="bg-zinc-950 text-white" blob="bg-violet-600" label="Intro">
      <p class="reveal text-sm font-semibold tracking-[0.3em] text-lime-300 uppercase" style="--i:0">{site.title}</p>
      <h1 class="font-display mt-4 leading-[0.8] font-extrabold tracking-tighter">
        <span class="reveal block text-[clamp(6rem,28vw,20rem)]" style="--i:1">{site.year}</span>
        <span class="reveal mt-2 block text-[clamp(2.5rem,8vw,6rem)] text-lime-300" style="--i:2">Wrapped</span>
      </h1>
      <p class="reveal mt-8 max-w-xl text-xl text-white/80 sm:text-2xl" style="--i:3">{site.tagline}</p>
      <a href="#numbers" class="reveal mt-12 inline-flex items-center gap-3 font-semibold" style="--i:4">
        <span class="animate-bounce-slow grid size-12 place-items-center rounded-full bg-lime-300 text-2xl text-zinc-950">↓</span>
        Scroll or press → to start
      </a>
      <div class="reveal mt-10 -mx-4 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_15%,black_85%,transparent)] sm:-mx-10 lg:-mx-20" style="--i:5" aria-hidden="true">
        <p class="animate-marquee font-display w-max text-2xl font-bold text-white/70 whitespace-nowrap">
          {marquee} &nbsp;·&nbsp; {marquee} &nbsp;·&nbsp;
        </p>
      </div>
    </Slide>

    <!-- 2. Year in numbers -->
    <Slide id="numbers" class="bg-lime-300 text-zinc-950" blob="bg-emerald-500" label="Year in numbers">
      <h2 class="reveal font-display max-w-3xl text-4xl leading-none font-extrabold tracking-tight sm:text-6xl" style="--i:0">
        This year, the AI on your own devices got a lot smarter.
      </h2>
      <!-- Jump to a chapter -->
      <nav aria-label="Chapters" class="mt-8 sm:mt-10">
        <ol
          class="grid gap-x-10 sm:grid-flow-col sm:grid-cols-2 sm:[grid-template-rows:repeat(var(--rows),auto)]"
          style={`--rows:${Math.ceil(chapterLinks.length / 2)}`}
        >
          {
            chapterLinks.map((link, i) => (
              <li
                class:list={[
                  'reveal border-t border-zinc-950/20',
                  // No line above the first row of each column (only the first on phones, where it is one column).
                  i === 0 && 'border-t-0',
                  i === Math.ceil(chapterLinks.length / 2) && 'sm:border-t-0',
                ]}
                style={`--i:${i + 1}`}
              >
                <a href={`#${link.id}`} class="group flex items-baseline gap-4 py-2.5 sm:py-3">
                  <span class="font-display w-8 shrink-0 text-lg font-extrabold opacity-50">{link.number}</span>
                  <span class="font-display text-2xl leading-tight font-extrabold tracking-tight group-hover:underline sm:text-3xl">
                    {link.title}
                  </span>
                  <span class="ml-auto text-xl transition group-hover:translate-x-1" aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <dl class="mt-8 grid sm:mt-10 gap-3 sm:grid-cols-3 sm:gap-4">
        {
          stats.map((s, i) => (
            <div class="reveal flex flex-col-reverse rounded-3xl bg-zinc-950 p-4 text-lime-300 sm:p-6" style={`--i:${i + 7}`}>
              <dt class="mt-3 font-medium text-white/85 sm:text-lg">{s.label}</dt>
              <dd
                class:list={[
                  'font-display leading-none font-extrabold tracking-tighter break-words',
                  typeof s.value === 'number' ? 'text-6xl' : 'text-4xl xl:text-5xl',
                ]}
              >
                {s.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </Slide>

    <!-- 3. Chapters: an opener slide, then one slide per news item (or everything on the opener for `single` chapters) -->
    {
      chapters.map(({ section, items }, c) => (
        <>
          <SectionSlide section={section} number={c + 1} items={items} />
          {!('single' in section) && items.map((item) =>
            item.data.timeline ? (
              <TimelineSlide item={item} index={news.indexOf(item)} total={news.length} />
            ) : (
              <NewsSlide item={item} index={news.indexOf(item)} total={news.length} />
            ),
          )}
        </>
      ))
    }

    <!-- 4. Bonus tracks: short items from src/content/more/ -->
    {
      more.length > 0 && (
        <Slide id="more" class="bg-fuchsia-500 text-zinc-950" blob="bg-orange-400" label={site.more.title}>
          <p class="reveal text-sm font-semibold tracking-[0.3em] uppercase" style="--i:0">
            {site.more.kicker}
          </p>
          <h2 class="reveal font-display mt-3 text-5xl leading-none font-extrabold tracking-tight sm:text-7xl" style="--i:1">
            {site.more.title}
          </h2>
          <ul class="mt-10 grid gap-4 md:grid-cols-2">
            {more.map((m, i) => (
              <li class="reveal" style={`--i:${i + 2}`}>
                <a
                  href={m.data.link.url}
                  target="_blank"
                  rel="noopener"
                  class="group flex h-full gap-4 rounded-3xl bg-zinc-950 p-5 text-white transition hover:-rotate-1 hover:scale-[1.02] sm:p-6"
                >
                  <span class="text-4xl leading-none" aria-hidden="true">{m.data.emoji}</span>
                  <span class="min-w-0">
                    <span class="block text-sm font-semibold text-fuchsia-300">
                      {formatDate(m.data.date)} · {m.data.org}
                    </span>
                    <span class="font-display mt-1 block text-2xl leading-tight font-extrabold">{m.data.title}</span>
                    <span class="mt-2 block leading-snug text-white/80">{m.data.summary}</span>
                    <span class="mt-3 block text-sm font-semibold text-fuchsia-300 group-hover:underline">
                      {m.data.link.label} ↗
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </Slide>
      )
    }

    <!-- 5. Closing credits, in NobodyWho's brand colours -->
    <Slide id="credits" class="nw-ground font-nw text-nw-ink" blob="bg-nw-glow" label={`${credits.kicker} ${credits.name}`}>
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:items-center lg:gap-12">
        <div>
          <p class="reveal font-nw-mono text-sm font-medium tracking-[0.2em] text-nw-accent uppercase" style="--i:0">
            {credits.kicker}
          </p>
          <h2 class="reveal mt-3 text-[clamp(3rem,6.5vw,5.5rem)] leading-[0.9] font-bold tracking-tight" style="--i:1">
            {credits.name}
          </h2>
          <p class="reveal mt-4 text-2xl font-semibold text-nw-accent sm:text-3xl" style="--i:2">{credits.slogan}</p>
          <p class="reveal mt-5 max-w-xl text-lg leading-relaxed text-nw-ink/75" style="--i:3">{credits.body}</p>
          <div class="reveal mt-8 flex flex-wrap gap-3" style="--i:4">
            <a
              href={credits.github}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-full bg-nw-accent px-5 py-3 font-semibold text-nw-deep transition hover:scale-105"
            >
              <svg viewBox="0 0 16 16" class="size-5" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
              </svg>
              Star us on GitHub
            </a>
            <a
              href={credits.website}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1.5 rounded-full px-5 py-3 font-semibold ring-1 ring-nw-ink/35 ring-inset transition hover:bg-nw-ink/10"
            >
              nobodywho.ai
              <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 14.5 14.5 5.5M7 5.5h7.5V13" /></svg>
            </a>
          </div>
        </div>

        <ul class="reveal flex flex-wrap justify-center gap-3 sm:gap-4" style="--i:5" aria-label="NobodyWho docs by platform">
          {credits.platforms.map((p) => (
            <li class="w-[calc((100%-2.25rem)/4)] sm:w-[calc((100%-3rem)/4)]">
              <a
                href={p.url}
                target="_blank"
                rel="noopener"
                class="group flex aspect-square h-full flex-col items-center justify-center gap-2 rounded-3xl border border-nw-ink/20 bg-nw-deep/70 p-3 backdrop-blur transition hover:-translate-y-1 hover:border-nw-accent/60 hover:text-nw-accent"
              >
                <svg viewBox="0 0 24 24" class="size-9 shrink-0 transition group-hover:scale-110 sm:size-11" fill="currentColor" aria-hidden="true">
                  <path d={p.icon} />
                </svg>
                <span class="text-center text-xs leading-tight font-semibold sm:text-sm">{p.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-nw-ink/30 pt-6" style="--i:6">
        <p class="text-xl font-semibold">{credits.signoff}</p>
        <a href="#intro" class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 font-semibold ring-1 ring-nw-ink/35 ring-inset transition hover:bg-nw-ink/10">
          <svg viewBox="0 0 24 24" class="size-[1.1rem]" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg>
          Watch again
        </a>
      </div>
    </Slide>
  </main>

  {news.some((n) => n.data.tryOnPhone) && <TryOnPhone />}

  <script>
    const deck = document.getElementById('deck')!;
    const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
    const bars = [...document.querySelectorAll<HTMLElement>('[data-progress]')];
    let current = 0;

    const setCurrent = (index: number) => {
      current = index;
      bars.forEach((bar, i) => {
        bar.dataset.state = i < index ? 'done' : i === index ? 'current' : 'todo';
        if (i === index) bar.setAttribute('aria-current', 'step');
        else bar.removeAttribute('aria-current');
      });
    };

    // On scroll: reveal slides as they come into view, and mark the slide
    // crossing the middle of the screen as "current" for the progress bar.
    const update = () => {
      const top = deck.scrollTop;
      const height = deck.clientHeight;
      let middle = 0;
      slides.forEach((slide, i) => {
        if (slide.offsetTop < top + height * 0.7 && slide.offsetTop + slide.offsetHeight > top) {
          slide.dataset.visible = '';
        }
        if (slide.offsetTop <= top + height / 2) middle = i;
      });
      if (middle !== current) {
        setCurrent(middle);
        // Keep the URL on the slide in view, like the arrow keys do, so it can be shared or reloaded.
        history.replaceState(null, '', `#${slides[middle].id}`);
      }
    };
    deck.addEventListener('scroll', update, { passive: true });
    setCurrent(0);
    update();

    const go = (index: number) => {
      const next = Math.max(0, Math.min(slides.length - 1, index));
      const target = slides[next];
      setCurrent(next); // update now so fast repeated key presses keep counting
      target.scrollIntoView({ behavior: 'smooth' });
      history.replaceState(null, '', `#${target.id}`);
    };

    document.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (document.querySelector('dialog[open]')) return; // let an open popup keep the keyboard
      if (['ArrowRight', 'ArrowDown', 'PageDown', 'j'].includes(e.key)) {
        e.preventDefault();
        go(current + 1);
      } else if (['ArrowLeft', 'ArrowUp', 'PageUp', 'k'].includes(e.key)) {
        e.preventDefault();
        go(current - 1);
      }
    });
  </script>
</Layout>
